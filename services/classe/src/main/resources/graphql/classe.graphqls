type Query {
    listClasses : [Classe],
    getClasseById(id: Int): Classe
}

type Mutation {
    createClasse (name : String) : Classe
    updateClasse(id: Int, name : String): Classe
    deleteClasse(id: Int) : Classe
}

type Classe {
    id : Int
    name : String
}